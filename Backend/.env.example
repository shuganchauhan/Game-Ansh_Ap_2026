NODE_ENV=development
PORT=3000
TRUST_PROXY=0

# Local Docker Compose PostgreSQL. Replace for your environment.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/gamers_g

# Local Docker Compose Redis. Configure TLS for managed production Redis.
REDIS_URL=redis://127.0.0.1:6379

# Replace this placeholder with a cryptographically random secret (32+ chars).
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=12h

# Comma-separated exact browser origins. Never use * in production.
CORS_ORIGINS=http://localhost:5173

# Optional one-time administrator provisioning. Set outside source control.
ADMIN_EMAIL=
ADMIN_PASSWORD=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
STRICT_LIMIT_WINDOW_MS=3600000
STRICT_LIMIT_MAX=30
AUTH_LIMIT_WINDOW_MS=900000
AUTH_LIMIT_MAX=10
